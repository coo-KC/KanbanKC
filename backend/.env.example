# Render Backend Environment Variables Example
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/KanbaKan?retryWrites=true&w=majority
FRONTEND_ORIGIN=https://your-app.vercel.app

# Firebase Admin credentials: use the ignored local file for development.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# In deployment settings, set FIREBASE_SERVICE_ACCOUNT_JSON to the full
# single-line service account JSON instead of setting the path above.

# Generate a unique persistent value for production (for example, with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
GATE_JWT_SECRET=replace-with-a-unique-random-secret
