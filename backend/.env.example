# Render Backend Environment Variables Example
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/KanbaKan?retryWrites=true&w=majority
FRONTEND_ORIGIN=https://your-app.vercel.app

# Firebase Admin Service Account Key (Provide EITHER JSON string OR Path)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"KanbaKan",...}
# OR
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
